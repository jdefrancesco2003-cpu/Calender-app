# CalPal Environment Variables
# Copy this to .env and fill in your values

# Anthropic API key (required) - get from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MongoDB connection string (optional - falls back to localStorage)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/calendar

# Server port (default: 3000)
PORT=3000

# ── Future: Auth (not yet implemented) ──
# JWT secret for signing user tokens (generate with: openssl rand -hex 32)
# JWT_SECRET=your_jwt_secret_here

# ── Future: E2E Encryption (not yet implemented) ──
# Not needed server-side — encryption happens client-side in the browser

# ── Future: Email (not yet implemented) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your_password
